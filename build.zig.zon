.{
    .name = .zig_cov,
    .fingerprint = 0x53616c3862b55df9,
    .version = "0.1.0",
    // The project tracks Zig master (CI installs `version: master`). This is a
    // FLOOR, not an exact pin: it records the latest master this was verified
    // against. Zig only errors if the local compiler is OLDER than this; a newer
    // master may introduce breaking std/build changes that need porting. Bump
    // this whenever the sources are re-verified against a newer master.
    .minimum_zig_version = "0.17.0-dev.1509+bb296ab9b",
    .paths = .{"."},
}
